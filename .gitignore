########################################################
# 🧠 PORTFOLIO NELVB — CONFIGURACIÓN .GITIGNORE
# Proyecto React 19 + Webpack 5 + Flask (email backend)
# Mantiene el entorno limpio y evita subir archivos generados.
########################################################

# --- SISTEMA Y EDITOR ---------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
*.stackdump
*.log
*.tmp
*.bak
*.swp
*.swo

# --- VARIABLES Y CONFIGURACIÓN -------------------------
.env
.env.local
.env.*.local
.env.production
.env.development

# --- DEPENDENCIAS -------------------------------------
node_modules/
__pycache__/
*.py[cod]
*.pyo
*.pyd

# --- BUILD / OUTPUT -----------------------------------
/build/
/dist/
/.venv/
/.venv*/
/coverage/
/.cache/
/.terraform/
/.vscode-test/

# --- PUBLIC / STATIC FILES -----------------------------
public/*
!public/Cv_Nelson_Valero.pdf
!public/Cv_Nelson_english.pdf

# --- ARCHIVOS TEMPORALES DE DEPLOY ---------------------
.now
.vercel
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json*
Pipfile.lock

# --- ARCHIVOS COMPILADOS / EJECUTABLES ----------------
*.com
*.class
*.dll
*.exe
*.o
*.so

# --- ARCHIVOS COMPRIMIDOS ------------------------------
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# --- EXCEPCIONES (ARCHIVOS QUE DEBES SEGUIR) -----------
!.gitignore
!.github/
!.vscode/
!.eslintrc
!.env.example
!.devcontainer/
!.devcontainer/*
!.gitpod.yml
!.htaccess
!webpack.common.js
!webpack.dev.js
!webpack.prod.js
!package.json
!README.md
!DOCUMENTACION_COMPLETA.md
!AUDITORIA_PORTFOLIO.md
!TECNOLOGIAS_USADAS.md

########################################################
# Fin del archivo .gitignore — actualizado por Nelvb
########################################################
